# Google Maps Embed API key (https://console.cloud.google.com/ -> Maps Embed API)
# 未設定の場合はキー不要の簡易埋め込み(maps.google.com/maps?output=embed)にフォールバックします
VITE_GOOGLE_MAPS_EMBED_KEY=

# 取得済みデータ(data/*.json)の配信元。未設定なら GitHub の main ブランチを見る
# ローカル検証時は http://localhost:8899 のように差し替える
VITE_DATA_BASE=

# Google Analytics 4 の測定ID。未設定なら src/utils/analytics.ts の既定値を使います
# 別のIDで計測する場合は G-XXXXXXXXXX を、計測を止める場合は空のままにしてください
# いずれも本番ビルド（npm run build）でのみ有効。開発サーバーでは送信しません
VITE_GA_MEASUREMENT_ID=
